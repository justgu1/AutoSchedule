{
    "name": "autoschedule/backend",
    "description": "AutoSchedule backend",
    "type": "project",
    "require": {
        "php": "^8.4",
        "predis/predis": "^2.3",
        "psr/log": "^3.0",
        "firebase/php-jwt": "^7.1",
        "symfony/mailer": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
