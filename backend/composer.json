{
    "name": "autoschedule/backend",
    "description": "AutoSchedule backend",
    "type": "project",
    "require": {
        "php": "^8.5",
        "predis/predis": "^2.3",
        "psr/log": "^3.0",
        "firebase/php-jwt": "^7.1",
        "symfony/mailer": "^8.1",
        "league/flysystem-aws-s3-v3": "^3.29"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.95",
        "rector/rector": "^2.6",
        "deptrac/deptrac": "^4.0"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --exclude-group integration",
        "test:integration": "phpunit --group integration",
        "arch": "deptrac analyse --config-file=deptrac.yaml"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
